# Next.js web BFF (:3001) — standalone output
# Build: docker build -f docker/Dockerfile.web -t hcp-web .

ARG NODE_IMAGE=node:22-bookworm-slim
ARG NPM_REGISTRY=https://registry.npmmirror.com

FROM ${NODE_IMAGE} AS build
ARG NPM_REGISTRY
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
COPY packages/domain/package.json packages/domain/
COPY packages/db/package.json packages/db/
COPY packages/mcp-client/package.json packages/mcp-client/
COPY packages/medical-kb/package.json packages/medical-kb/
COPY packages/hcp-engagement-agent/package.json packages/hcp-engagement-agent/
COPY packages/hcp-twin-mcp/package.json packages/hcp-twin-mcp/
COPY apps/web/package.json apps/web/

ENV npm_config_sharp_binary_host=https://npmmirror.com/mirrors/sharp \
    npm_config_sharp_libvips_binary_host=https://npmmirror.com/mirrors/sharp-libvips

RUN npm config set registry "${NPM_REGISTRY}" \
  && npm ci

COPY tsconfig.base.json ./
COPY packages/domain packages/domain
COPY packages/db packages/db
COPY packages/mcp-client packages/mcp-client
COPY packages/medical-kb packages/medical-kb
COPY packages/hcp-engagement-agent packages/hcp-engagement-agent
COPY apps/web apps/web

RUN npm run build -w @hca/domain -w @hca/db -w @hca/mcp-client -w @hca/medical-kb -w @hca/hcp-engagement-agent -w @hca/web

FROM ${NODE_IMAGE} AS runner
WORKDIR /app
ENV NODE_ENV=production \
    PORT=3001 \
    HOSTNAME=0.0.0.0

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd --system --gid 1001 nodejs \
  && useradd --system --uid 1001 --gid nodejs nextjs

COPY --from=build --chown=nextjs:nodejs /app/apps/web/public ./apps/web/public
COPY --from=build --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=build --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static

USER nextjs
EXPOSE 3001
CMD ["node", "apps/web/server.js"]
