{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": false,
    "noImplicitAny": false,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM"],
    "paths": {
      "cursor/canvas": ["./canvas-shim.d.ts"]
    }
  },
  "include": ["*.canvas.tsx", "*.d.ts"]
}
