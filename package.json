{
  "name": "hcp-engagement-assistant",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @hca/domain -w @hca/db -w @hca/hcp-twin-mcp",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "db:migrate": "npm run migrate -w @hca/db",
    "dev:hcp-twin-mcp": "npm run dev -w @hca/hcp-twin-mcp",
    "start:hcp-twin-mcp": "npm run start -w @hca/hcp-twin-mcp"
  },
  "engines": {
    "node": ">=20"
  }
}
