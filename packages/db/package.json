{
  "name": "@hca/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/migrate.ts",
    "migrate:pg-to-mysql": "tsx src/migrate-pg-to-mysql.ts",
    "migrate:mysql-to-mysql": "tsx src/migrate-mysql-to-mysql.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hca/domain": "*",
    "mysql2": "^3.14.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "@vitest/coverage-v8": "^4.1.0",
    "pg": "^8.22.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
