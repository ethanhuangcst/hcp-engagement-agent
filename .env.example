# Copy to .env and fill secrets. Do not commit .env.

# MySQL (primary store for Twin / Insights / Options / sessions)
# Host: 38.55.199.241  User: root  DB: hca  Port: 3306
# URL-encode special chars in password (e.g. @ → %40)
DATABASE_URL=mysql://root:YOUR_PASSWORD@38.55.199.241:3306/hca

# Optional: remote MySQL connect timeout (ms). Default in code: 30000.
# MYSQL_CONNECT_TIMEOUT_MS=30000

# Optional: RAG corpus + Qdrant volume root (not the Twin primary store)
HCA_DATA_DIR=./data

# Qdrant (vectors only)
QDRANT_URL=http://127.0.0.1:6333
VECTOR_BACKEND=qdrant-local
# QDRANT_ALLOW_NON_LOCAL=false

# RAG embedding / rerank (real models; Xenova IDs or local paths)
EMBEDDING_MODEL=Xenova/bge-small-zh-v1.5
# HF mirror for first-time model download (China-friendly)
HF_ENDPOINT=https://hf-mirror.com
TRANSFORMERS_REMOTE_HOST=https://hf-mirror.com
# Optional: OpenAI-compatible intranet embedding instead of local Xenova
# EMBEDDING_BASE_URL=https://your-intranet/v1
# EMBEDDING_API_KEY=
# Skip cross-encoder download; cosine over real dense vectors is used
RERANK_DISABLE=true
# RERANK_MODEL=Xenova/bge-reranker-base

# MCP (local npm run / Docker Compose overrides MCP_URL to http://hcp-twin-mcp:3200)
MCP_URL=http://127.0.0.1:3200
MCP_TRANSPORT=http
MCP_PORT=3200
# 产品默认 live。mock 仅 CI：须同时 ALLOW_TWIN_MOCK=1
TWIN_MODE=live
# ALLOW_TWIN_MOCK=1

# LLM (server-side only; browser never holds keys)
LLM_PROVIDER=qwen
LLM_MODEL=qwen-plus
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_MODEL=qwen-plus
# Or OpenAI-compatible:
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_STRICT=false

# Optional
# REDIS_URL=redis://127.0.0.1:6379
# NCBI_API_KEY=
