# Copy to .env.local and fill secrets. Do not commit .env.local.

# MySQL primary store for Twin / Insights / Options / sessions (ADR-005)
DATABASE_URL=mysql://root:YOUR_PASSWORD@<DB_HOST>:3306/hca

# Optional: RAG corpus + Qdrant volume root (not the Twin primary store)
HCA_DATA_DIR=./data

# Qdrant (vectors only)
QDRANT_URL=http://127.0.0.1:6333
VECTOR_BACKEND=qdrant-local
# QDRANT_ALLOW_NON_LOCAL=false

# RAG embedding / rerank (real models; Xenova IDs or local paths)
EMBEDDING_MODEL=Xenova/bge-small-zh-v1.5
# HF mirror for first-time model download (China-friendly)
HF_ENDPOINT=https://hf-mirror.com
TRANSFORMERS_REMOTE_HOST=https://hf-mirror.com
# Optional: OpenAI-compatible intranet embedding instead of local Xenova
# EMBEDDING_BASE_URL=https://your-intranet/v1
# EMBEDDING_API_KEY=
# Skip cross-encoder download; cosine over real dense vectors is used
RERANK_DISABLE=true
# RERANK_MODEL=Xenova/bge-reranker-base

# MCP
MCP_URL=http://127.0.0.1:3200
MCP_TRANSPORT=http
MCP_PORT=3200
# 产品默认 live。mock 仅 CI：须同时 ALLOW_TWIN_MOCK=1
TWIN_MODE=live
# ALLOW_TWIN_MOCK=1

# LLM (server-side only; browser never holds keys)
LLM_PROVIDER=qwen
LLM_MODEL=qwen-plus
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_MODEL=qwen-plus
# Or OpenAI-compatible:
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_STRICT=false

# Optional
# REDIS_URL=redis://127.0.0.1:6379
# NCBI_API_KEY=

# 2.0: TWIN2-01 scheduled twin refresh (off when unset)
# TWIN_REFRESH_CRON=0 2 * * *
# TWIN_REFRESH_TTL_HOURS=24

# 2.0: external MCP (hcp-engagement-mcp, Streamable HTTP only, ADR-008)
# MCP2_PORT=3300

# Playwright 浏览器二进制：走阿里云 npmmirror（安装 playwright / npx playwright install 前 export 或 source 本文件）
PLAYWRIGHT_DOWNLOAD_HOST=https://cdn.npmmirror.com/binaries/playwright
