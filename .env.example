# Copy to .env and fill secrets. Do not commit .env.

# Hong Kong Postgres (primary store for Twin / Insights / Options / sessions)
# Host: 101.132.156.250  User: postgres  DB: hca
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@101.132.156.250:5432/hca

# Optional: RAG corpus + Qdrant volume root (not the Twin primary store)
HCA_DATA_DIR=./data

# Qdrant (vectors only)
QDRANT_URL=http://127.0.0.1:6333
VECTOR_BACKEND=qdrant-local

# MCP
MCP_URL=http://127.0.0.1:3200
MCP_TRANSPORT=http
MCP_PORT=3200
TWIN_MODE=live

# LLM (server-side only)
LLM_PROVIDER=qwen
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=

# Optional
# REDIS_URL=redis://127.0.0.1:6379
# NCBI_API_KEY=
