{
  "name": "@hca/medical-kb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed:compliance": "tsx src/cli/seed-compliance.ts",
    "ingest:academic": "tsx src/cli/ingest-academic.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hca/db": "*",
    "@hca/domain": "*",
    "@qdrant/js-client-rest": "^1.14.0",
    "@xenova/transformers": "^2.17.2",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
